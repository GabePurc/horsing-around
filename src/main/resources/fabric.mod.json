{
	"schemaVersion": 1,
	"id": "horsingaround",
	"version": "${version}",
	"name": "Horsing Around",
	"description": "Horses finally ride like real animals: gaits, momentum, stamina, sure footing and an over-the-shoulder camera, on the vanilla horse with the keys you already know.",
	"authors": [
		"GabePurc"
	],
	"contact": {
		"sources": "https://github.com/GabePurc/horsing-around",
		"issues": "https://github.com/GabePurc/horsing-around/issues/new?template=bug_report.yml"
	},
	"license": "LGPL-3.0-only",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.horsingaround.fabric.HorsingAroundFabric"
		],
		"client": [
			"dev.horsingaround.client.fabric.HorsingAroundFabricClient"
		],
		"modmenu": [
			"dev.horsingaround.client.fabric.HorseModMenu"
		]
	},
	"mixins": [
		"horsingaround.mixins.json",
		{
			"config": "horsingaround.client.mixins.json",
			"environment": "client"
		},
		"horsingaround.icy.mixins.json",
		{
			"config": "horsingaround.icy.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"icon": "assets/horsingaround/icon.png",
	"suggests": {
		"modmenu": "*"
	},
	"breaks": {
		"horsingaround_shoulder": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.buymeacoffee": "https://buymeacoffee.com/blintzbug"
			}
		}
	}
}

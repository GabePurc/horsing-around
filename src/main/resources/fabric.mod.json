{
	"schemaVersion": 1,
	"id": "horsingaround",
	"version": "${version}",
	"name": "Horsing Around",
	"description": "Weighty, momentum-based horse riding kept close to vanilla: gaits and stamina, turning inertia, a riding camera, and horses that pick their way.",
	"authors": [
		"GabePurc"
	],
	"contact": {
		"sources": "https://github.com/GabePurc/horsing-around",
		"issues": "https://github.com/GabePurc/horsing-around/issues/new?template=bug_report.yml"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.horsingaround.HorsingAround"
		],
		"client": [
			"dev.horsingaround.client.HorsingAroundClient"
		],
		"modmenu": [
			"dev.horsingaround.client.config.HorseModMenu"
		]
	},
	"mixins": [
		"horsingaround.mixins.json",
		{
			"config": "horsingaround.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"icon": "assets/horsingaround/icon.png",
	"suggests": {
		"modmenu": "*",
		"horsingaround_shoulder": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.buymeacoffee": "https://buymeacoffee.com/blintzbug"
			}
		}
	}
}
